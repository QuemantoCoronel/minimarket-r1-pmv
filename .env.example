# --- Zona Horaria Obligatoria ---
TZ=America/Lima
DJANGO_TIME_ZONE=America/Lima

# --- Django Core ---
DJANGO_SECRET_KEY=cambiar-en-entorno-local-solo-desarrollo-inseguro
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_SETTINGS_MODULE=config.settings

# --- Base de Datos (PostgreSQL 17) ---
POSTGRES_DB=r1_pmv_db
POSTGRES_USER=r1_pmv_user
POSTGRES_PASSWORD=r1_pmv_local_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://r1_pmv_user:r1_pmv_local_pass@db:5432/r1_pmv_db

# --- Puerto de exposición local ---
WEB_PORT=8000