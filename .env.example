# Copy this file to .env and replace every blank secret locally. Never commit .env.
APP_ENV=local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=false

# Leave DATABASE_URL empty only for local SQLite development.
# For PostgreSQL use: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

POSTGRES_DB=r1_pmv
POSTGRES_USER=pmv_bootstrap
POSTGRES_PASSWORD=
POSTGRES_MIGRATOR_USER=pmv_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=pmv_app
POSTGRES_APP_PASSWORD=

# Required only by `python manage.py seed_pmv`.
SEED_ADMIN_PASSWORD=
SEED_WAREHOUSE_PASSWORD=
SEED_SELLER_PASSWORD=

